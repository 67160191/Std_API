                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has current user info\", function () {",
                  "  pm.expect(response).to.have.property(\"data\");",
                  "  pm.expect(response.data).to.have.property(\"email\");",
                  "});"
