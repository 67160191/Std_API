    {
      "name": "Students",
      "item": [
        {
          "name": "GET Students",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// GET Students - Scripts > Post-response",
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has pagination info\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property(\"pagination\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST Create Student",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const studentEmail = 'student_' + Date.now() + '@example.com';",
                  "pm.environment.set('studentEmail', studentEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) {",
                  "  pm.environment.set(\"studentId\", body.data.id);",
                  "}",
                  "",
                  "pm.test(\"Status code is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has created student data\", function () {",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "  pm.expect(body.data).to.have.property(\"id\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"นักศึกษา ทดสอบ\",\n  \"major\": \"วิทยาการคอมพิวเตอร์\",\n  \"email\": \"{{studentEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET Student by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has student data\", function () {",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "  pm.expect(body.data).to.have.property(\"name\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "{{studentId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "PUT Update Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has updated student data\", function () {",
                  "  pm.expect(body).to.have.property(\"data\");",
                  "  pm.expect(body.data.name).to.eql(\"นักศึกษา ทดสอบ (แก้ไข)\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"นักศึกษา ทดสอบ (แก้ไข)\",\n  \"major\": \"เทคโนโลยีสารสนเทศ\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/students/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "{{studentId}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
